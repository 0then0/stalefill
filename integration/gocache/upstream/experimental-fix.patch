 // Set sets a value in available caches
 func (c *LoadableCache[T]) Set(ctx context.Context, key any, object T, options ...store.Option) error {
+	cacheKey := c.getCacheKey(key)
+	state := c.acquireState(cacheKey)
+	defer c.releaseState(cacheKey, state)
+	if err := state.lock(ctx); err != nil {
+		return err
+	}
+	defer state.unlock()
+	state.generation++
+	c.setCache.Delete(cacheKey)
 	return c.cache.Set(ctx, key, object, options...)
 }
 
-// Delete removes a value from cache
+// Delete removes a value from cache. For this instance and key, it waits for
+// an in-flight publication and invalidates older queued publications and loads.
+// The underlying cache must apply Set and Delete before returning for their
+// effects to have the same order. Other instances and direct store users are
+// not coordinated.
 func (c *LoadableCache[T]) Delete(ctx context.Context, key any) error {
+	cacheKey := c.getCacheKey(key)
+	state := c.acquireState(cacheKey)
+	defer c.releaseState(cacheKey, state)
+	if err := state.lock(ctx); err != nil {
+		return err
+	}
+	defer state.unlock()
+	state.generation++
 	// Drop the value possibly waiting to be stored in the main cache, otherwise
 	// a following Get would serve the value that has just been deleted.
 	c.setCache.Delete(c.getCacheKey(key))
