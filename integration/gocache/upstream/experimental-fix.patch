+// A state is retained by active operations and queued publications only.
+// The gate serializes publication with mutation for this instance and key.
+type loadableKeyState struct {
+	gate       chan struct{}
+	generation uint64
+	refs       int
+}
+
+func (s *loadableKeyState) lock(ctx context.Context) error {
+	select {
+	case s.gate <- struct{}{}:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func (s *loadableKeyState) unlock() { <-s.gate }
 
